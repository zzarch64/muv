#!/usr/bin/env bash
#
# muv - 共享 uv 环境管理器
#
# 用法:
#   muv <command> [options]
#   muv help
#
# 命令:
#   install [options]              安装或修复共享 uv 环境。
#     --prefix <dir>               安装前缀。默认: /opt/uv。
#     --group <name>               管理员组。默认: uvusers。
#     --index <url>                配置默认包索引地址。
#     --no-mirror                  不执行镜像自动选择。
#     --python <version>           安装默认托管 Python 版本。
#
#   mirror [url]                   配置镜像源。未提供 url 时自动选择。
#   grant <user>...                授权用户管理权限。
#   revoke <user>...               撤销用户管理权限。
#   update                         下载并替换 uv 与 uvx。
#   python add <version>           安装共享托管 Python 版本。
#   python rm <version>            删除共享托管 Python 版本。
#                                  删除前显示风险提示并要求确认。
#   python list                    列出已安装的共享 Python 版本。
#   doctor                         检查组、权限、ACL、二进制与索引状态。
#   help                           显示帮助信息。
#
# 权限:
#   install, grant, revoke         需要 root；非 root 调用会通过 sudo 重新执行。
#   mirror, update                 需要 root 或 UV_GROUP 成员身份。
#   python add, python rm          需要 root 或 UV_GROUP 成员身份。
#   python list, doctor, help      任意用户可执行。
#
# Shell 初始化:
#   source /opt/uv/env.sh
#
set -euo pipefail

UV_ROOT="${UV_ROOT:-/opt/uv}"
UV_GROUP="${UV_GROUP:-uvusers}"
ENV_FILE="$UV_ROOT/env.sh"

log()  { printf '\033[1;32m[muv]\033[0m %s\n' "$*"; }
warn() { printf '\033[1;33m[warn]\033[0m %s\n' "$*" >&2; }
die()  { printf '\033[1;31m[error]\033[0m %s\n' "$*" >&2; exit 1; }

# root 或管理员组成员可执行组可写资源的管理命令。
require_admin() {
  [ "$(id -u)" -eq 0 ] && return 0
  id -nG 2>/dev/null | tr ' ' '\n' | grep -qx "$UV_GROUP" && return 0
  die "需要是 root 或 $UV_GROUP 组成员才能执行此命令"
}

# root 命令由非 root 调用时通过 sudo 重新执行。
need_root() {
  if [ "$(id -u)" -ne 0 ]; then
    command -v sudo >/dev/null 2>&1 || die "需要 root 权限，且未找到 sudo"
    exec sudo -E UV_ROOT="$UV_ROOT" UV_GROUP="$UV_GROUP" "$0" "${ORIG_ARGS[@]}"
  fi
}

# 使用共享环境变量执行 uv/uvx。
uv_env() {
  PATH="$UV_ROOT/bin:$PATH" \
  UV_CACHE_DIR="$UV_ROOT/cache" UV_PYTHON_INSTALL_DIR="$UV_ROOT/python" \
  UV_PYTHON_CACHE_DIR="$UV_ROOT/python-cache" UV_MANAGED_PYTHON=true \
  UV_PYTHON_BIN_DIR="$UV_ROOT/bin" UV_LINK_MODE=hardlink \
  UV_PYTHON_DOWNLOADS=manual "$@"
}

# 使用 cnpip 选择镜像 URL。
pick_fastest_index() {
  local out url
  out="$(uv_env "$UV_ROOT/bin/uvx" cnpip list 2>/dev/null)" || return 1
  url="$(printf '%s\n' "$out" \
    | awk '/ms/ && /https?:\/\// {for(i=1;i<=NF;i++) if($i ~ /^https?:\/\//){print $i; exit}}')"
  [ -n "$url" ] && { printf '%s\n' "$url"; return 0; } || return 1
}

# 写入 env.sh 的 UV_DEFAULT_INDEX 默认值。
write_index() {
  local url="$1"
  [ -f "$ENV_FILE" ] || die "未找到 $ENV_FILE，请先执行 muv install"
  sed -i -E "s#(export UV_DEFAULT_INDEX=\\\$\{UV_DEFAULT_INDEX:-)[^}]*(\})#\1${url}\2#" "$ENV_FILE"
  grep -q "UV_DEFAULT_INDEX:-${url}}" "$ENV_FILE" \
    || die "写入失败，请检查 $ENV_FILE 中的 UV_DEFAULT_INDEX 行"
  log "镜像源已写入 env.sh: $url"
}

# 使用官方安装脚本下载 uv/uvx 到指定目录。
bootstrap_uv() {
  local dest="$1"
  command -v curl >/dev/null 2>&1 || command -v wget >/dev/null 2>&1 \
    || die "需要 curl 或 wget 下载 uv，或手动把 uv/uvx 放入 bin/ 后重试"
  log "未找到 uv 二进制，从 astral.sh 下载到 $dest"
  mkdir -p "$dest"
  local fetch
  if command -v curl >/dev/null 2>&1; then fetch="curl -LsSf https://astral.sh/uv/install.sh"
  else fetch="wget -qO- https://astral.sh/uv/install.sh"; fi
  $fetch | env UV_INSTALL_DIR="$dest" UV_NO_MODIFY_PATH=1 INSTALLER_NO_MODIFY_PATH=1 sh \
    || die "uv 下载/安装失败"
  [ -x "$dest/uv" ] && [ -x "$dest/uvx" ] || die "下载后仍未找到 $dest/uv（或 uvx）"
}

# ---------------- 子命令 ----------------

cmd_init() {
  local index_url="" do_mirror=1 default_python="3.12" src_dir
  while [ $# -gt 0 ]; do
    case "$1" in
      --prefix)    UV_ROOT="$2"; ENV_FILE="$UV_ROOT/env.sh"; shift 2 ;;
      --group)     UV_GROUP="$2"; shift 2 ;;
      --index)     index_url="$2"; do_mirror=0; shift 2 ;;
      --no-mirror) do_mirror=0; shift ;;
      --python)    default_python="$2"; shift 2 ;;
      *)           die "install: 未知参数 $1" ;;
    esac
  done
  need_root
  command -v setfacl >/dev/null 2>&1 || die "缺少 setfacl，请先安装 acl 包"

  # 二进制来源：脚本所在目录的 ./bin，或已部署的 $UV_ROOT/bin
  src_dir="$(cd "$(dirname "$(readlink -f "$0")")" && pwd)"
  local uv_src uvx_src
  for base in "$src_dir/bin" "$src_dir" "$UV_ROOT/bin"; do
    if [ -x "$base/uv" ] && [ -x "$base/uvx" ]; then uv_src="$base/uv"; uvx_src="$base/uvx"; break; fi
  done
  if [ -z "${uv_src:-}" ]; then
  # 仓库未自带二进制时，使用官方脚本下载到临时目录。
    local tmp; tmp="$(mktemp -d)"; trap 'rm -rf "$tmp"' RETURN
    bootstrap_uv "$tmp"
    uv_src="$tmp/uv"; uvx_src="$tmp/uvx"
  fi

  # hardlink 跨分区提示
  local rfs hfs
  rfs="$(df -P "$(dirname "$UV_ROOT")" 2>/dev/null | awk 'NR==2{print $1}')"
  hfs="$(df -P /home 2>/dev/null | awk 'NR==2{print $1}')"
  [ -n "$rfs" ] && [ -n "$hfs" ] && [ "$rfs" != "$hfs" ] \
    && warn "$UV_ROOT 与 /home 不同分区，hardlink 将退化为 copy"

  getent group "$UV_GROUP" >/dev/null && log "组 $UV_GROUP 已存在" \
    || { log "创建组 $UV_GROUP"; groupadd "$UV_GROUP"; }

  log "创建目录并设置权限"
  mkdir -p "$UV_ROOT"/{bin,cache,python,python-cache,tools}
  # 仅管理员可写：bin/tools/python/python-cache（Python 版本由管理员集中管理）
  for d in "$UV_ROOT" "$UV_ROOT"/{bin,tools,python,python-cache}; do
    chown root:"$UV_GROUP" "$d"; chmod 2775 "$d"; done
  # 缓存所有用户可读写（可重建）
  chown root:"$UV_GROUP" "$UV_ROOT/cache"; chmod 2777 "$UV_ROOT/cache"

  log "设置 default ACL"
  for d in "$UV_ROOT" "$UV_ROOT"/{bin,cache,python,python-cache,tools}; do
    setfacl -d -m g:"$UV_GROUP":rwx "$d"; done
  # 仅 cache 对 others 开放写
  setfacl -d -m o:rwx "$UV_ROOT/cache"; chmod -R o+rw "$UV_ROOT/cache" 2>/dev/null || true

  log "部署 uv / uvx / pip / env.sh / muv"
  install -m 0775 -o root -g "$UV_GROUP" "$uv_src"  "$UV_ROOT/bin/uv"
  install -m 0775 -o root -g "$UV_GROUP" "$uvx_src" "$UV_ROOT/bin/uvx"
  printf '#!/usr/bin/env bash\nexec %s/bin/uv pip "$@"\n' "$UV_ROOT" > "$UV_ROOT/bin/pip"
  chmod 0755 "$UV_ROOT/bin/pip"
  [ -f "$src_dir/env.sh" ] && [ "$src_dir" != "$UV_ROOT" ] \
    && install -m 0664 "$src_dir/env.sh" "$ENV_FILE"
  # env.sh 设为组可写，管理员可直接执行 set-index。
  chown root:"$UV_GROUP" "$ENV_FILE" 2>/dev/null || true
  chmod 0664 "$ENV_FILE"
  # 将所选前缀和组写入部署后的 env.sh 默认值；仍允许环境变量覆盖。
  sed -i -E "s#(UV_ROOT=\"\\\$\{UV_ROOT:-)[^}]*(\}\")#\1${UV_ROOT}\2#;
             s#(UV_GROUP=\"\\\$\{UV_GROUP:-)[^}]*(\}\")#\1${UV_GROUP}\2#" "$ENV_FILE"
  # 将 muv 安装到共享 bin。
  [ "$(readlink -f "$0")" = "$UV_ROOT/bin/muv" ] \
    || install -m 0775 -o root -g "$UV_GROUP" "$(readlink -f "$0")" "$UV_ROOT/bin/muv"

  if [ "$do_mirror" -eq 1 ]; then
    log "使用 cnpip 选择镜像"
    index_url="$(pick_fastest_index)" && log "选择镜像: $index_url" || warn "镜像选择失败，保留当前配置"
  fi
  [ -n "$index_url" ] && write_index "$index_url"

  log "安装默认 Python $default_python"
  uv_env "$UV_ROOT/bin/uv" python install "$default_python"
  local pybin
  pybin="$(uv_env "$UV_ROOT/bin/uv" python find "$default_python" 2>/dev/null || true)"
  if [ -n "$pybin" ] && [ -x "$pybin" ]; then
    ln -sf "$pybin" "$UV_ROOT/bin/python3.${default_python#*.}"
    ln -sf "$pybin" "$UV_ROOT/bin/python3"
    ln -sf "$pybin" "$UV_ROOT/bin/python"
    log "python symlink -> $pybin"
  fi

  cmd_doctor
  cat <<EOF

安装完成。请在用户 shell 配置中加入：source $ENV_FILE
管理命令已安装到：$UV_ROOT/bin/muv
EOF
}

cmd_set_index() {
  require_admin
  local url="${1:-}"
  if [ -z "$url" ]; then
    log "使用 cnpip 选择镜像"
    url="$(pick_fastest_index)" || die "镜像选择失败，请显式指定: muv mirror <url>"
    log "选择镜像: $url"
  fi
  write_index "$url"
}

cmd_grant() {
  need_root
  [ $# -gt 0 ] || die "用法: muv grant <user>..."
  getent group "$UV_GROUP" >/dev/null || die "组 $UV_GROUP 不存在，请先执行 muv install"
  for u in "$@"; do
    id "$u" >/dev/null 2>&1 || { warn "用户 $u 不存在，已忽略"; continue; }
    usermod -aG "$UV_GROUP" "$u" && log "$u 已加入 $UV_GROUP（需重新登录生效）"
  done
}

cmd_revoke() {
  need_root
  [ $# -gt 0 ] || die "用法: muv revoke <user>..."
  for u in "$@"; do
    id "$u" >/dev/null 2>&1 || { warn "用户 $u 不存在，已忽略"; continue; }
    gpasswd -d "$u" "$UV_GROUP" && log "$u 已移出 $UV_GROUP（需重新登录生效）"
  done
}

cmd_update() {
  require_admin
  # 始终从官网下载最新版到临时目录
  local tmp; tmp="$(mktemp -d)"; trap 'rm -rf "$tmp"' RETURN
  bootstrap_uv "$tmp"
  local old new
  old="$("$UV_ROOT/bin/uv" --version 2>/dev/null || echo 'none')"
  install -m 0775 -g "$UV_GROUP" "$tmp/uv"  "$UV_ROOT/bin/uv"
  install -m 0775 -g "$UV_GROUP" "$tmp/uvx" "$UV_ROOT/bin/uvx"
  new="$("$UV_ROOT/bin/uv" --version 2>/dev/null || echo '?')"
  log "uv 已更新: $old -> $new"
}

cmd_python() {
  local action="${1:-}"; shift || true
  local ver=""
  while [ $# -gt 0 ]; do
    case "$1" in
      -*)       die "未知参数: $1" ;;
      *)
        [ -z "$ver" ] || die "只能指定一个 Python 版本"
        ver="$1"; shift
        ;;
    esac
  done
  case "$action" in
    add)
      require_admin
      [ -n "$ver" ] || die "用法: muv python add <ver>"
      log "安装共享 Python $ver 到 $UV_ROOT/python"
      uv_env "$UV_ROOT/bin/uv" python install "$ver"
      log "Python $ver 已安装到共享目录；已加载 env.sh 的用户可使用该版本"
      ;;
    rm|remove|uninstall)
      require_admin
      [ -n "$ver" ] || die "用法: muv python rm <ver>"
      local pbin
      pbin="$(uv_env "$UV_ROOT/bin/uv" python find "$ver" 2>/dev/null || true)"
      [ -n "$pbin" ] || die "未找到已安装的共享 Python $ver"
      warn "删除后，基于 Python $ver 的 venv 可能因解释器路径缺失而无法运行；重新执行 muv python add $ver 可恢复同一路径"
      printf '确认删除 Python %s？[y/N] ' "$ver" >&2
      read -r ans 2>/dev/null || ans=""
      case "$ans" in y|Y|yes|YES) ;; *) die "已取消" ;; esac
      uv_env "$UV_ROOT/bin/uv" python uninstall "$ver"
      log "已删除共享 Python $ver"
      ;;
    list|"")
      uv_env "$UV_ROOT/bin/uv" python list --only-installed
      ;;
    *) die "用法: muv python {add|rm|list} [ver]" ;;
  esac
}

cmd_doctor() {
  log "检查 $UV_ROOT"
  local ok=1
  getent group "$UV_GROUP" >/dev/null && echo "  组 $UV_GROUP: 正常" \
    || { echo "  组 $UV_GROUP: 缺失"; ok=0; }
  [ -x "$UV_ROOT/bin/uv" ] && echo "  uv: 正常 $("$UV_ROOT/bin/uv" --version 2>/dev/null)" \
    || { echo "  uv: 缺失"; ok=0; }
  if command -v getfacl >/dev/null 2>&1; then
    getfacl -p "$UV_ROOT/cache" 2>/dev/null | grep -q '^default:other::rwx' \
      && echo "  cache default ACL(other=rwx): 正常" \
      || { echo "  cache default ACL(other=rwx): 缺失"; ok=0; }
  else warn "未找到 getfacl，未检查 ACL"; fi
  grep -q '^export UV_DEFAULT_INDEX=' "$ENV_FILE" 2>/dev/null \
    && echo "  镜像源: $(sed -n -E 's/.*UV_DEFAULT_INDEX:-([^}]*)\}.*/\1/p' "$ENV_FILE")" \
    || echo "  镜像源: 未配置"
  [ "$ok" -eq 1 ] && log "检查通过" || { warn "检查未通过"; return 1; }
}

cmd_help() { awk 'NR>1 && /^[^#]/{exit} NR>1{sub(/^# ?/,""); print}' "$0"; }

# ---------------- 分发 ----------------
ORIG_ARGS=("$@")
cmd="${1:-help}"; shift || true
case "$cmd" in
  install)           cmd_init "$@" ;;
  mirror)            cmd_set_index "$@" ;;
  grant)             cmd_grant "$@" ;;
  revoke)            cmd_revoke "$@" ;;
  update)            cmd_update "$@" ;;
  python)            cmd_python "$@" ;;
  doctor)            cmd_doctor "$@" ;;
  help|-h|--help)    cmd_help ;;
  *)                 die "未知命令: $cmd（muv help 查看用法）" ;;
esac
