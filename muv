#!/usr/bin/env bash
#
# muv - 共享 uv 环境管理器
#
# 用法:
#   muv <command> [options]
#   muv help
#
# 命令:
#   install [options]               安装/修复共享环境。
#     --prefix <dir>                安装前缀。默认: /opt/uv。
#     --group <name>                管理员组。默认: uvusers。
#     --index <url|auto>            配置包索引地址。auto=自动测速选镜像；不传则保留现有配置。
#     --python <version>            安装默认托管 Python 版本。默认: 3.12。
#   mirror [url]                    配置镜像源并锁定缓存（需 root）。未提供 url 时自动选择。
#   grant <user>...                 授权用户管理权限。
#   revoke <user>...                撤销用户管理权限。
#   update                          下载并替换 uv 与 uvx。
#   python add <version>            安装共享托管 Python 版本。
#   python rm [--yes] <version>     删除共享托管 Python 版本。
#   python list                     列出已安装的共享 Python 版本。
#   doctor                          检查组、权限、ACL、二进制与索引状态。
#   help                            显示帮助信息。
#   --version                       显示 muv 版本。
#
set -euo pipefail

# ===== 常量 =====

MUV_VERSION="0.1.0"
MUV_LOG_NAME="${MUV_LOG_NAME:-muv}"

# ===== 上下文检测 =====

# 始终计算脚本所在目录（不受 UV_ROOT 预设影响）。
_self="$(readlink -f "$0" 2>/dev/null || printf '%s\n' "$0")"
MUV_SELF_DIR="$(cd "$(dirname "$_self")" && pwd -P)"
MUV_RUNTIME_SRC="$_self"

# 模板目录：env.sh / muv 所在的目录。
# 源码模式下 MUV_SELF_DIR 就是源码根目录（muv 和 env.sh 同级）；
# 已安装模式下 MUV_SELF_DIR 是 $PREFIX/bin，模板在 $PREFIX。
if [ "$(basename "$MUV_SELF_DIR")" = "bin" ] && [ -f "$MUV_SELF_DIR/../env.sh" ]; then
  MUV_TEMPLATE_DIR="$(cd "$MUV_SELF_DIR/.." && pwd -P)"
else
  MUV_TEMPLATE_DIR="$MUV_SELF_DIR"
fi

MUV_EXPLICIT_UV_ROOT=0
if [ -n "${UV_ROOT+x}" ]; then
  MUV_EXPLICIT_UV_ROOT=1
  MUV_RUNNING_MODE="installed"
else
  if [ "$(basename "$MUV_SELF_DIR")" = "bin" ]; then
    local_parent="$(cd "$MUV_SELF_DIR/.." && pwd -P)"
    if [ -f "$local_parent/env.sh" ]; then
      MUV_RUNNING_MODE="installed"
      UV_ROOT="$local_parent"
    else
      MUV_RUNNING_MODE="source"
      UV_ROOT="/opt/uv"
    fi
  else
    MUV_RUNNING_MODE="source"
    UV_ROOT="/opt/uv"
  fi
fi
UV_GROUP="${UV_GROUP:-uvusers}"
ENV_FILE="$UV_ROOT/env.sh"
CONFIG_FILE="$UV_ROOT/config.env"

# ===== 工具函数 =====

log()  { printf '\033[1;32m[%s]\033[0m %s\n' "$MUV_LOG_NAME" "$*"; }
warn() { printf '\033[1;33m[warn]\033[0m %s\n' "$*" >&2; }
die()  { printf '\033[1;31m[error]\033[0m %s\n' "$*" >&2; exit 1; }

shell_quote() {
  printf "'%s'" "$(printf '%s' "$1" | sed "s/'/'\\\\''/g")"
}

require_option_value() {
  local context="$1" opt="$2" argc="$3"
  [ "$argc" -ge 2 ] || die "$context: $opt 需要参数"
}

run_uv() {
  PATH="$UV_ROOT/bin:$PATH" \
  UV_CACHE_DIR="$UV_ROOT/cache" UV_PYTHON_INSTALL_DIR="$UV_ROOT/python" \
  UV_PYTHON_CACHE_DIR="$UV_ROOT/python-cache" UV_MANAGED_PYTHON=true \
  UV_PYTHON_BIN_DIR="$UV_ROOT/bin" UV_LINK_MODE=hardlink \
  UV_PYTHON_DOWNLOADS=manual "$UV_ROOT/bin/uv" "$@"
}

pick_fastest_index() {
  local out url
  out="$(PATH="$UV_ROOT/bin:$PATH" \
         UV_CACHE_DIR="$UV_ROOT/cache" UV_PYTHON_INSTALL_DIR="$UV_ROOT/python" \
         UV_PYTHON_CACHE_DIR="$UV_ROOT/python-cache" UV_MANAGED_PYTHON=true \
         UV_PYTHON_BIN_DIR="$UV_ROOT/bin" UV_LINK_MODE=hardlink \
         UV_PYTHON_DOWNLOADS=manual \
         "$UV_ROOT/bin/uvx" cnpip list 2>/dev/null)" || return 1
  url="$(printf '%s\n' "$out" \
    | awk '/ms/ && /https?:\/\// {for(i=1;i<=NF;i++) if($i ~ /^https?:\/\//){print $i; exit}}')"
  [ -n "$url" ] && { printf '%s\n' "$url"; return 0; } || return 1
}

read_config_var() {
  local name="$1" line value="" found=0 single_quoted_re
  [[ "$name" =~ ^[A-Za-z_][A-Za-z0-9_]*$ ]] || return 2
  [ -f "$CONFIG_FILE" ] || return 1
  while IFS= read -r line || [ -n "$line" ]; do
    case "$line" in
      "$name="*) value="${line#*=}"; found=1 ;;
    esac
  done < "$CONFIG_FILE"
  [ "$found" -eq 1 ] || return 1

  single_quoted_re="^'([^']*)'$"
  if [[ "$value" =~ $single_quoted_re ]]; then
    printf '%s\n' "${BASH_REMATCH[1]}"
    return 0
  fi
  if [[ "$value" =~ ^[A-Za-z0-9_./:@%+=,~-]*$ ]]; then
    printf '%s\n' "$value"
    return 0
  fi
  return 1
}

write_runtime_config() {
  local index_url="${1:-}" existing_index tmp
  [ -d "$UV_ROOT" ] || die "未找到 $UV_ROOT，请先执行 muv install"
  if [ -z "$index_url" ]; then
    existing_index="$(read_config_var MUV_DEFAULT_INDEX 2>/dev/null || true)"
    index_url="$existing_index"
  fi
  tmp="$CONFIG_FILE.tmp.$$"
  {
    printf '# Generated by muv. Do not commit machine-specific values.\n'
    printf 'MUV_GROUP=%s\n' "$(shell_quote "$UV_GROUP")"
    if [ -n "$index_url" ]; then
      printf 'MUV_DEFAULT_INDEX=%s\n' "$(shell_quote "$index_url")"
    fi
  } > "$tmp" || die "写入失败: $tmp"
  mv "$tmp" "$CONFIG_FILE" || die "写入失败: $CONFIG_FILE"
  chown root:"$UV_GROUP" "$CONFIG_FILE" 2>/dev/null || true
  chmod 0664 "$CONFIG_FILE" 2>/dev/null || true
}

write_index() {
  local url="$1"
  [ -f "$ENV_FILE" ] || die "未找到 $ENV_FILE，请先执行 muv install"
  write_runtime_config "$url"
  [ "$(read_config_var MUV_DEFAULT_INDEX 2>/dev/null || true)" = "$url" ] \
    || die "写入失败，请检查 $CONFIG_FILE"
  log "镜像源已写入 $CONFIG_FILE: $url"
}

bootstrap_uv() {
  local dest="$1"
  command -v curl >/dev/null 2>&1 || command -v wget >/dev/null 2>&1 \
    || die "需要 curl 或 wget 下载 uv，或手动把 uv/uvx 放入 bin/ 后重试"
  log "未找到 uv 二进制，从 astral.sh 下载到 $dest"
  mkdir -p "$dest"
  local -a fetch_cmd
  if command -v curl >/dev/null 2>&1; then
    fetch_cmd=(curl -LsSf https://astral.sh/uv/install.sh)
  else
    fetch_cmd=(wget -qO- https://astral.sh/uv/install.sh)
  fi
  "${fetch_cmd[@]}" | env UV_INSTALL_DIR="$dest" UV_NO_MODIFY_PATH=1 INSTALLER_NO_MODIFY_PATH=1 sh \
    || die "uv 下载/安装失败"
  [ -x "$dest/uv" ] && [ -x "$dest/uvx" ] || die "下载后仍未找到 $dest/uv（或 uvx）"
}

acquire_muv_lock() {
  local lock_file="$UV_ROOT/.muv.lock"
  exec 9>"$lock_file" || die "无法创建锁文件: $lock_file"
  if command -v flock >/dev/null 2>&1; then
    flock -n 9 || die "另一个 muv 操作正在执行"
  else
    warn "未找到 flock，无法启用并发保护"
  fi
  chown root:"$UV_GROUP" "$lock_file" 2>/dev/null || true
  chmod 0664 "$lock_file" 2>/dev/null || true
}

# root 在 sticky 缓存目录里留下的普通文件，会被 Linux fs.protected_regular
# 拦截（非 root 用户无法 open root 拥有的文件，即使权限位是 666）。
# 此函数将 root 拥有的缓存文件转交给实际操作者（SUDO_USER 或 uvusers 成员）。
# 仅在 root 身份下有效。
fix_root_cache() {
  [ "$(id -u)" -eq 0 ] || return 0
  [ -d "$UV_ROOT/cache" ] || return 0

  local target=""
  # 优先用 SUDO_USER（谁跑的 sudo muv install）
  [ -n "${SUDO_USER:-}" ] && id "$SUDO_USER" &>/dev/null && target="$SUDO_USER"
  # 回退：取 uvusers 组的第一个成员
  [ -z "$target" ] && target=$(getent group "$UV_GROUP" 2>/dev/null | cut -d: -f4 | cut -d, -f1)
  [ -n "$target" ] || return 0

  local count
  count=$(find "$UV_ROOT/cache" -mindepth 1 -user root -type f -printf . 2>/dev/null | wc -c)
  [ "$count" -gt 0 ] || return 0

  find "$UV_ROOT/cache" -mindepth 1 -user root -type f \
    -exec chown "$target:$UV_GROUP" {} + 2>/dev/null || true
  log "已修复 $count 个 root 拥有的缓存文件 -> $target"
}

# 检查缓存中是否有 root 拥有的文件（doctor 用）。
# 返回文件数（0 表示无问题）。
check_root_cache() {
  [ -d "$UV_ROOT/cache" ] || { printf '%s\n' "0"; return; }
  find "$UV_ROOT/cache" -mindepth 1 -user root -type f -printf . 2>/dev/null | wc -c
}

# ===== 缓存源锁定 =====
#
# uv 缓存按"源 URL 哈希"在 simple-v*/index/ 与 wheels-v*/index/ 下分桶。
# 锁定 index/ 这一层（chown root + ACL mask/other 降为 r-x）后，只有 root
# 能在其下新建桶，普通用户无法用 --default-index 切换到其它源写入新桶。
# 已存在的审定桶仍对所有用户可写（桶自身权限不变），default ACL 保持 rwx
# 保证 root 新建的审定桶仍世界可写。

# 对每个存在的 index 目录执行操作。$1=操作函数。
# 目标：$UV_ROOT/cache/{simple,wheels}-v*/index
for_each_index_dir() {
  local action="$1" d
  for d in "$UV_ROOT"/cache/simple-v*/index "$UV_ROOT"/cache/wheels-v*/index; do
    [ -d "$d" ] || continue
    "$action" "$d"
  done
}

# 锁定单个 index 目录：只有 root 能在其下新建桶。
lock_index_dir() {
  local dir="$1"
  chown root:"$UV_GROUP" "$dir" 2>/dev/null || true
  setfacl -m o::r-x,m::r-x "$dir" 2>/dev/null || true
  setfacl -d -m g:"$UV_GROUP":rwx,o::rwx "$dir" 2>/dev/null || true
}

# 解锁单个 index 目录：恢复组/other 可写，供预热建桶。
unlock_index_dir() {
  local dir="$1"
  setfacl -m o::rwx,m::rwx "$dir" 2>/dev/null || true
}

# 判断单个 index 目录是否已锁定：owner=root 且 ACL mask/other 均为 r-x。
index_dir_is_locked() {
  local dir="$1" acl
  [ "$(stat -c '%U' "$dir" 2>/dev/null)" = "root" ] || return 1
  acl="$(getfacl -p "$dir" 2>/dev/null)" || return 1
  printf '%s\n' "$acl" | grep -q '^mask::r-x$' || return 1
  printf '%s\n' "$acl" | grep -q '^other::r-x$' || return 1
  return 0
}

# 用指定审定源真实安装一个极小包，建出 simple + wheels 审定桶。
# 必须显式传 --default-index（run_uv 未设 UV_DEFAULT_INDEX，否则会给 pypi.org 建桶）。
# 失败返回非 0，调用方据此跳过加锁，避免把环境锁成不可用。
prewarm_index() {
  local url="$1" tmp rc=0
  [ -n "$url" ] || return 1
  tmp="$(mktemp -d)" || return 1
  run_uv pip install --default-index "$url" --target "$tmp" six >/dev/null 2>&1 || rc=1
  rm -rf "$tmp"
  fix_root_cache
  return "$rc"
}

# ===== 运行时函数 =====

# root 或管理员组成员可执行组可写资源的管理命令。
require_admin() {
  [ "$(id -u)" -eq 0 ] && return 0
  id -nG 2>/dev/null | tr ' ' '\n' | grep -qx "$UV_GROUP" && return 0
  die "需要是 root 或 $UV_GROUP 组成员才能执行此命令"
}

# root 命令由非 root 调用时通过 sudo 重新执行。
need_root() {
  if [ "$(id -u)" -ne 0 ]; then
    command -v sudo >/dev/null 2>&1 || die "需要 root 权限，且未找到 sudo"
    exec sudo -E UV_ROOT="$UV_ROOT" UV_GROUP="$UV_GROUP" "$MUV_RUNTIME_SRC" "${ORIG_ARGS[@]}"
  fi
}

# 对每个有效用户执行操作。$1=操作函数，$@=用户列表。
foreach_user() {
  local action="$1"; shift
  [ $# -gt 0 ] || die "用法: muv ${cmd} <user>..."
  getent group "$UV_GROUP" >/dev/null || die "组 $UV_GROUP 不存在，请先执行 muv install"
  for u in "$@"; do
    id "$u" >/dev/null 2>&1 || { warn "用户 $u 不存在，已忽略"; continue; }
    "$action" "$u"
  done
}

# 换源后重建并锁定 index：解锁 → 清空所有旧桶 → 用新源预热建桶 → 重新锁定。
# 仅删 index/ 下的桶（元数据），绝不触碰内容寻址的 archive-v0/，故不影响已装 venv。
relock_index_for_url() {
  local url="$1"
  for_each_index_dir unlock_index_dir
  for_each_index_dir _clear_index_buckets
  if prewarm_index "$url"; then
    for_each_index_dir lock_index_dir
    log "已锁定缓存 index：仅审定源 $url，普通用户无法切换源"
  else
    warn "预热审定源失败，未锁定 index（保持可用）"
  fi
}

_clear_index_buckets() {
  local dir="$1"
  rm -rf "${dir:?}"/* 2>/dev/null || true
}

cmd_mirror() {
  need_root
  require_admin
  acquire_muv_lock
  local url="${1:-}"
  if [ -z "$url" ]; then
    log "使用 cnpip 选择镜像"
    url="$(pick_fastest_index)" || die "镜像选择失败，请显式指定: muv mirror <url>"
    log "选择镜像: $url"
  fi
  write_index "$url"
  relock_index_for_url "$url"
}

_do_grant()  { usermod -aG "$UV_GROUP" "$1" && log "$1 已加入 $UV_GROUP（需重新登录生效）"; }
_do_revoke() { gpasswd -d "$1" "$UV_GROUP" && log "$1 已移出 $UV_GROUP（需重新登录生效）"; }

cmd_grant()  { need_root; foreach_user _do_grant  "$@"; }
cmd_revoke() { need_root; foreach_user _do_revoke "$@"; }

cmd_update() {
  need_root
  require_admin
  acquire_muv_lock
  local tmp; tmp="$(mktemp -d)"; trap 'rm -rf "$tmp"' EXIT
  bootstrap_uv "$tmp"
  local old new
  old="$("$UV_ROOT/bin/uv" --version 2>/dev/null || echo 'none')"
  install -m 0775 -o root -g "$UV_GROUP" "$tmp/uv"  "$UV_ROOT/bin/uv"
  install -m 0775 -o root -g "$UV_GROUP" "$tmp/uvx" "$UV_ROOT/bin/uvx"
  new="$("$UV_ROOT/bin/uv" --version 2>/dev/null || echo '?')"
  rm -rf "$tmp"
  trap - EXIT
  log "uv 已更新: $old -> $new"

  # uv 升级可能让缓存版本目录跳号（simple-v21→v22 等），新目录无锁。
  # 若已配置审定源，重新预热并锁定。
  local cfg_index
  cfg_index="$(read_config_var MUV_DEFAULT_INDEX 2>/dev/null || true)"
  if [ -n "$cfg_index" ]; then
    relock_index_for_url "$cfg_index"
  fi
}

cmd_python() {
  local action="${1:-}"; shift || true
  local ver="" assume_yes=0
  while [ $# -gt 0 ]; do
    case "$1" in
      --yes|-y) assume_yes=1; shift ;;
      -*)       die "未知参数: $1" ;;
      *)
        [ -z "$ver" ] || die "只能指定一个 Python 版本"
        ver="$1"; shift
        ;;
    esac
  done
  case "$action" in
    add)
      require_admin
      acquire_muv_lock
      [ -n "$ver" ] || die "用法: muv python add <ver>"
      log "安装共享 Python $ver 到 $UV_ROOT/python"
      run_uv python install "$ver"
      fix_root_cache
      log "Python $ver 已安装到共享目录；已加载 env.sh 的用户可使用该版本"
      ;;
    rm|remove|uninstall)
      require_admin
      acquire_muv_lock
      [ -n "$ver" ] || die "用法: muv python rm <ver>"
      local pbin ans
      pbin="$(run_uv python find "$ver" 2>/dev/null || true)"
      [ -n "$pbin" ] || die "未找到已安装的共享 Python $ver"
      warn "删除后，基于 Python $ver 的 venv 可能因解释器路径缺失而无法运行；重新执行 muv python add $ver 可恢复同一路径"
      if [ "$assume_yes" -ne 1 ]; then
        printf '确认删除 Python %s？[y/N] ' "$ver" >&2
        read -r ans 2>/dev/null < /dev/tty || ans=""
        case "$ans" in y|Y|yes|YES) ;; *) die "已取消" ;; esac
      fi
      run_uv python uninstall "$ver"
      log "已删除共享 Python $ver"
      ;;
    list|"")
      [ -z "$ver" ] && [ "$assume_yes" -eq 0 ] || die "用法: muv python list"
      run_uv python list --only-installed
      ;;
    *) die "用法: muv python {add|rm|list} [ver]" ;;
  esac
}

cmd_doctor() {
  log "检查 $UV_ROOT"
  local ok=1 index_url
  getent group "$UV_GROUP" >/dev/null && echo "  组 $UV_GROUP: OK" \
    || { echo "  组 $UV_GROUP: 缺失"; ok=0; }
  [ -r "$ENV_FILE" ] && echo "  env.sh: OK" \
    || { echo "  env.sh: 缺失"; ok=0; }
  [ -r "$CONFIG_FILE" ] && echo "  config.env: OK" \
    || { echo "  config.env: 缺失"; ok=0; }
  [ -x "$UV_ROOT/bin/uv" ] && echo "  uv: OK $("$UV_ROOT/bin/uv" --version 2>/dev/null)" \
    || { echo "  uv: 缺失"; ok=0; }
  if command -v getfacl >/dev/null 2>&1; then
    getfacl -p "$UV_ROOT/cache" 2>/dev/null | grep -q '^default:other::rwx' \
      && echo "  cache default ACL(other=rwx): OK" \
      || { echo "  cache default ACL(other=rwx): 缺失"; ok=0; }
  else warn "未找到 getfacl，未检查 ACL"; fi
  [ -k "$UV_ROOT/cache" ] && echo "  cache sticky bit: OK" \
    || { echo "  cache sticky bit: 缺失"; ok=0; }
  local root_files
  root_files="$(check_root_cache)"
  if [ "$root_files" -gt 0 ] 2>/dev/null; then
    echo "  cache root 文件: $root_files 个（fs.protected_regular 会阻止非 root 用户访问）"
    if [ "$(id -u)" -eq 0 ]; then
      fix_root_cache
    else
      warn "以 sudo muv doctor 运行可自动修复"
    fi
    ok=0
  else
    echo "  cache root 文件: OK"
  fi
  index_url="$(read_config_var MUV_DEFAULT_INDEX 2>/dev/null || true)"
  [ -n "$index_url" ] && echo "  镜像源: $index_url" || echo "  镜像源: 未配置"

  if [ -z "$index_url" ]; then
    echo "  index 锁: 未启用（未配置审定源）"
  else
    local idx_total=0 idx_locked=0 d
    for d in "$UV_ROOT"/cache/simple-v*/index "$UV_ROOT"/cache/wheels-v*/index; do
      [ -d "$d" ] || continue
      idx_total=$((idx_total + 1))
      index_dir_is_locked "$d" && idx_locked=$((idx_locked + 1))
    done
    if [ "$idx_total" -eq 0 ]; then
      echo "  index 锁: 暂无 index 目录（尚未拉取过包）"
    elif [ "$idx_locked" -eq "$idx_total" ]; then
      echo "  index 锁: OK（$idx_locked/$idx_total）"
    else
      echo "  index 锁: 未锁定（$idx_locked/$idx_total，普通用户可切换源写入新桶）"
      warn "以 sudo muv mirror $index_url 重新锁定"
      ok=0
    fi
  fi

  [ "$ok" -eq 1 ] && log "检查通过" || { warn "存在问题，见上"; return 1; }
}

cmd_version() { printf 'muv %s\n' "$MUV_VERSION"; }

# ===== 安装函数 =====

cleanup_temp_dirs() {
  [ "${#TEMP_DIRS[@]}" -eq 0 ] || rm -rf "${TEMP_DIRS[@]}"
}

set_uv_root() {
  UV_ROOT="$1"
  ENV_FILE="$UV_ROOT/env.sh"
  CONFIG_FILE="$UV_ROOT/config.env"
}

find_uv_binaries() {
  local src_dir="$MUV_TEMPLATE_DIR"
  uv_src="" uvx_src=""
  for base in "$src_dir/bin" "$src_dir" "$UV_ROOT/bin"; do
    if [ -x "$base/uv" ] && [ -x "$base/uvx" ]; then uv_src="$base/uv"; uvx_src="$base/uvx"; break; fi
  done
  if [ -z "$uv_src" ]; then
    local tmp; tmp="$(mktemp -d)"; TEMP_DIRS+=("$tmp")
    bootstrap_uv "$tmp"
    uv_src="$tmp/uv"; uvx_src="$tmp/uvx"
  fi
}

setup_dirs() {
  log "创建目录并设置权限"
  mkdir -p "${ALL_DIRS[@]}"
  for d in "${ADMIN_DIRS[@]}"; do
    chown root:"$UV_GROUP" "$d"; chmod 2775 "$d"
  done
  chown root:"$UV_GROUP" "$UV_ROOT/cache"; chmod 3777 "$UV_ROOT/cache"
}

setup_acl() {
  log "设置 default ACL"
  for d in "${ALL_DIRS[@]}"; do
    setfacl -d -m g:"$UV_GROUP":rwx "$d"
  done
  setfacl -d -m o:rwx "$UV_ROOT/cache"
  chmod o+rwx "$UV_ROOT/cache"
}

safe_install() {
  local src="$1" dest="$2"; shift 2
  if [ "$(readlink -f "$src" 2>/dev/null)" = "$(readlink -f "$dest" 2>/dev/null)" ]; then
    chown root:"$UV_GROUP" "$dest" 2>/dev/null || true
    chmod 0775 "$dest" 2>/dev/null || true
  else
    install "$@" "$src" "$dest"
  fi
}

deploy_files() {
  local src_dir="$1" index_url="${2:-}" env_src runtime_src
  env_src="$src_dir/env.sh"
  runtime_src="$MUV_RUNTIME_SRC"
  [ -f "$env_src" ] || die "缺少模板: $env_src"
  [ -f "$runtime_src" ] || die "缺少 muv: $runtime_src"

  log "部署 uv / uvx / pip / env.sh / muv"
  safe_install "$uv_src"  "$UV_ROOT/bin/uv"  -m 0775 -o root -g "$UV_GROUP"
  safe_install "$uvx_src" "$UV_ROOT/bin/uvx" -m 0775 -o root -g "$UV_GROUP"
  printf '#!/usr/bin/env bash\nexec %s/bin/uv pip "$@"\n' "$(shell_quote "$UV_ROOT")" > "$UV_ROOT/bin/pip"
  chown root:"$UV_GROUP" "$UV_ROOT/bin/pip"
  chmod 0755 "$UV_ROOT/bin/pip"

  if [ "$(readlink -f "$env_src" 2>/dev/null)" != "$(readlink -f "$ENV_FILE" 2>/dev/null)" ]; then
    install -m 0664 "$env_src" "$ENV_FILE"
  fi
  chown root:"$UV_GROUP" "$ENV_FILE" 2>/dev/null || true
  chmod 0664 "$ENV_FILE" 2>/dev/null || true

  safe_install "$runtime_src" "$UV_ROOT/bin/muv" -m 0775 -o root -g "$UV_GROUP"
  write_runtime_config "$index_url"
}

setup_python() {
  local ver="$1" pybin
  log "安装默认 Python $ver"
  run_uv python install "$ver"
  pybin="$(run_uv python find "$ver" 2>/dev/null || true)"
  if [ -n "$pybin" ] && [ -x "$pybin" ]; then
    ln -sf "$pybin" "$UV_ROOT/bin/python3.${ver#*.}"
    ln -sf "$pybin" "$UV_ROOT/bin/python3"
    ln -sf "$pybin" "$UV_ROOT/bin/python"
    log "python symlink -> $pybin"
  fi
}

cmd_install() {
  local index_url="" do_mirror=0 default_python="3.12"
  TEMP_DIRS=()
  trap cleanup_temp_dirs EXIT

  while [ $# -gt 0 ]; do
    case "$1" in
      --prefix)    require_option_value install "$1" "$#"; set_uv_root "$2"; shift 2 ;;
      --group)     require_option_value install "$1" "$#"; UV_GROUP="$2"; shift 2 ;;
      --index)
        require_option_value install "$1" "$#"
        if [ "$2" = "auto" ]; then
          do_mirror=1
        else
          index_url="$2"
        fi
        shift 2
        ;;
      --python)    require_option_value install "$1" "$#"; default_python="$2"; shift 2 ;;
      *)           die "install: 未知参数 $1" ;;
    esac
  done
  need_root
  command -v setfacl >/dev/null 2>&1 || die "缺少 setfacl，请先安装 acl 包"

  ADMIN_DIRS=("$UV_ROOT" "$UV_ROOT/bin" "$UV_ROOT/tools" "$UV_ROOT/python" "$UV_ROOT/python-cache")
  ALL_DIRS=("${ADMIN_DIRS[@]}" "$UV_ROOT/cache")

  find_uv_binaries

  local rfs hfs
  rfs="$(df -P "$(dirname "$UV_ROOT")" 2>/dev/null | awk 'NR==2{print $1}')"
  hfs="$(df -P /home 2>/dev/null | awk 'NR==2{print $1}')"
  [ -n "$rfs" ] && [ -n "$hfs" ] && [ "$rfs" != "$hfs" ] \
    && warn "$UV_ROOT 与 /home 不同分区，hardlink 将退化为 copy"

  getent group "$UV_GROUP" >/dev/null && log "组 $UV_GROUP 已存在" \
    || { log "创建组 $UV_GROUP"; groupadd "$UV_GROUP"; }

  setup_dirs
  setup_acl
  deploy_files "$MUV_TEMPLATE_DIR" "$index_url"

  if [ "$do_mirror" -eq 1 ]; then
    log "使用 cnpip 选择镜像"
    index_url="$(pick_fastest_index)" && log "选择镜像: $index_url" || warn "镜像选择失败，保留当前配置"
  fi
  [ -n "$index_url" ] && write_index "$index_url"

  setup_python "$default_python"
  fix_root_cache
  [ -n "$index_url" ] && relock_index_for_url "$index_url"
  "$UV_ROOT/bin/muv" doctor

  cat <<EOF

安装完成。请在用户 shell 配置中加入：source $ENV_FILE
管理命令已安装到：$UV_ROOT/bin/muv
EOF
}

# ===== 共用 =====

cmd_help() { awk 'NR>1 && /^[^#]/{exit} NR>1{sub(/^# ?/,""); print}' "$0"; }

# ===== 分发 =====

require_installed_context() {
  [ "$MUV_RUNNING_MODE" = "installed" ] || [ "$MUV_EXPLICIT_UV_ROOT" -eq 1 ] \
    || die "请先执行 ./muv install，然后使用 $UV_ROOT/bin/muv $cmd"
}

ORIG_ARGS=("$@")
cmd="${1:-help}"; shift || true
case "$cmd" in
  install)
    MUV_LOG_NAME=install
    cmd_install "$@"
    ;;
  mirror|grant|revoke|update|python|doctor)
    require_installed_context
    case "$cmd" in
      mirror)  cmd_mirror "$@" ;;
      grant)   cmd_grant "$@" ;;
      revoke)  cmd_revoke "$@" ;;
      update)  cmd_update "$@" ;;
      python)  cmd_python "$@" ;;
      doctor)  cmd_doctor "$@" ;;
    esac
    ;;
  help|-h|--help)    cmd_help ;;
  --version|version) cmd_version ;;
  *)                 die "未知命令: $cmd（muv help 查看用法）" ;;
esac
