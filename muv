#!/usr/bin/env bash
#
# muv - 已安装共享 uv 环境管理命令
#
# 用法:
#   muv <command> [options]
#   muv help
#
# 命令:
#   mirror [url]                   配置镜像源。未提供 url 时自动选择。
#   grant <user>...                授权用户管理权限。
#   revoke <user>...               撤销用户管理权限。
#   update                         下载并替换 uv 与 uvx。
#   python add <version>           安装共享托管 Python 版本。
#   python rm <version>            删除共享托管 Python 版本。
#                                  删除前显示风险提示并要求确认。
#   python list                    列出已安装的共享 Python 版本。
#   doctor                         检查组、权限、ACL、二进制与索引状态。
#   help                           显示帮助信息。
#
# 安装:
#   源码目录中的 install.sh 负责安装/修复共享环境，并把本文件部署为
#   $PREFIX/bin/muv。
#
set -euo pipefail

# ===== 配置 =====

default_uv_root() {
  local self dir parent
  self="$(readlink -f "$0" 2>/dev/null || printf '%s\n' "$0")"
  dir="$(cd "$(dirname "$self")" && pwd -P)"
  if [ "$(basename "$dir")" = "bin" ]; then
    parent="$(cd "$dir/.." && pwd -P)"
    [ -f "$parent/env.sh" ] && { printf '%s\n' "$parent"; return 0; }
  fi
  printf '%s\n' "/opt/uv"
}

MUV_EXPLICIT_UV_ROOT=0
if [ -n "${UV_ROOT+x}" ]; then
  MUV_EXPLICIT_UV_ROOT=1
else
  UV_ROOT="$(default_uv_root)"
fi
UV_GROUP="${UV_GROUP:-uvusers}"
ENV_FILE="$UV_ROOT/env.sh"
CONFIG_FILE="$UV_ROOT/muv.env"

# ===== 工具函数 =====

log()  { printf '\033[1;32m[muv]\033[0m %s\n' "$*"; }
warn() { printf '\033[1;33m[warn]\033[0m %s\n' "$*" >&2; }
die()  { printf '\033[1;31m[error]\033[0m %s\n' "$*" >&2; exit 1; }

shell_quote() {
  printf "'%s'" "$(printf '%s' "$1" | sed "s/'/'\\\\''/g")"
}

ensure_runtime_context() {
  local self dir parent
  [ "$MUV_EXPLICIT_UV_ROOT" -eq 1 ] && return 0
  self="$(readlink -f "$0" 2>/dev/null || printf '%s\n' "$0")"
  dir="$(cd "$(dirname "$self")" && pwd -P)"
  if [ "$(basename "$dir")" = "bin" ]; then
    parent="$(cd "$dir/.." && pwd -P)"
    [ "$parent" = "$UV_ROOT" ] && [ -f "$parent/env.sh" ] && return 0
  fi
  die "源码目录中的 muv 是安装后管理命令模板；请先执行 install.sh，然后使用 $UV_ROOT/bin/muv"
}

# root 或管理员组成员可执行组可写资源的管理命令。
require_admin() {
  [ "$(id -u)" -eq 0 ] && return 0
  id -nG 2>/dev/null | tr ' ' '\n' | grep -qx "$UV_GROUP" && return 0
  die "需要是 root 或 $UV_GROUP 组成员才能执行此命令"
}

# root 命令由非 root 调用时通过 sudo 重新执行。
need_root() {
  if [ "$(id -u)" -ne 0 ]; then
    command -v sudo >/dev/null 2>&1 || die "需要 root 权限，且未找到 sudo"
    exec sudo -E UV_ROOT="$UV_ROOT" UV_GROUP="$UV_GROUP" "$0" "${ORIG_ARGS[@]}"
  fi
}

# 使用共享环境变量执行 uv。
run_uv() {
  PATH="$UV_ROOT/bin:$PATH" \
  UV_CACHE_DIR="$UV_ROOT/cache" UV_PYTHON_INSTALL_DIR="$UV_ROOT/python" \
  UV_PYTHON_CACHE_DIR="$UV_ROOT/python-cache" UV_MANAGED_PYTHON=true \
  UV_PYTHON_BIN_DIR="$UV_ROOT/bin" UV_LINK_MODE=hardlink \
  UV_PYTHON_DOWNLOADS=manual "$UV_ROOT/bin/uv" "$@"
}

# 对每个有效用户执行操作。$1=操作函数，$@=用户列表。
foreach_user() {
  local action="$1"; shift
  [ $# -gt 0 ] || die "用法: muv ${cmd} <user>..."
  getent group "$UV_GROUP" >/dev/null || die "组 $UV_GROUP 不存在，请先执行 install.sh"
  for u in "$@"; do
    id "$u" >/dev/null 2>&1 || { warn "用户 $u 不存在，已忽略"; continue; }
    "$action" "$u"
  done
}

# ===== 镜像辅助 =====

# 使用 cnpip 选择镜像 URL。
pick_fastest_index() {
  local out url
  out="$(PATH="$UV_ROOT/bin:$PATH" \
         UV_CACHE_DIR="$UV_ROOT/cache" UV_PYTHON_INSTALL_DIR="$UV_ROOT/python" \
         UV_PYTHON_CACHE_DIR="$UV_ROOT/python-cache" UV_MANAGED_PYTHON=true \
         UV_PYTHON_BIN_DIR="$UV_ROOT/bin" UV_LINK_MODE=hardlink \
         UV_PYTHON_DOWNLOADS=manual \
         "$UV_ROOT/bin/uvx" cnpip list 2>/dev/null)" || return 1
  url="$(printf '%s\n' "$out" \
    | awk '/ms/ && /https?:\/\// {for(i=1;i<=NF;i++) if($i ~ /^https?:\/\//){print $i; exit}}')"
  [ -n "$url" ] && { printf '%s\n' "$url"; return 0; } || return 1
}

# 读取安装目录运行配置中的变量。
read_config_var() {
  local name="$1"
  [ -f "$CONFIG_FILE" ] || return 1
  (
    . "$CONFIG_FILE"
    eval "printf '%s\n' \"\${${name}:-}\""
  )
}

# 写入安装目录运行配置。env.sh 保持模板，不写入机器状态。
write_runtime_config() {
  local index_url="${1:-}" existing_index tmp
  [ -d "$UV_ROOT" ] || die "未找到 $UV_ROOT，请先执行 install.sh"
  if [ -z "$index_url" ]; then
    existing_index="$(read_config_var MUV_DEFAULT_INDEX 2>/dev/null || true)"
    index_url="$existing_index"
  fi
  tmp="$CONFIG_FILE.tmp.$$"
  {
    printf '# Generated by muv. Do not commit machine-specific values.\n'
    printf 'MUV_GROUP=%s\n' "$(shell_quote "$UV_GROUP")"
    [ -n "$index_url" ] && printf 'MUV_DEFAULT_INDEX=%s\n' "$(shell_quote "$index_url")"
  } > "$tmp" || die "写入失败: $tmp"
  mv "$tmp" "$CONFIG_FILE" || die "写入失败: $CONFIG_FILE"
  chown root:"$UV_GROUP" "$CONFIG_FILE" 2>/dev/null || true
  chmod 0664 "$CONFIG_FILE" 2>/dev/null || true
}

# 写入默认包索引。
write_index() {
  local url="$1"
  [ -f "$ENV_FILE" ] || die "未找到 $ENV_FILE，请先执行 install.sh"
  write_runtime_config "$url"
  [ "$(read_config_var MUV_DEFAULT_INDEX 2>/dev/null || true)" = "$url" ] \
    || die "写入失败，请检查 $CONFIG_FILE"
  log "镜像源已写入 $CONFIG_FILE: $url"
}

# 使用官方安装脚本下载 uv/uvx 到指定目录。
bootstrap_uv() {
  local dest="$1"
  command -v curl >/dev/null 2>&1 || command -v wget >/dev/null 2>&1 \
    || die "需要 curl 或 wget 下载 uv，或手动把 uv/uvx 放入 bin/ 后重试"
  log "未找到 uv 二进制，从 astral.sh 下载到 $dest"
  mkdir -p "$dest"
  local fetch
  if command -v curl >/dev/null 2>&1; then fetch="curl -LsSf https://astral.sh/uv/install.sh"
  else fetch="wget -qO- https://astral.sh/uv/install.sh"; fi
  $fetch | env UV_INSTALL_DIR="$dest" UV_NO_MODIFY_PATH=1 INSTALLER_NO_MODIFY_PATH=1 sh \
    || die "uv 下载/安装失败"
  [ -x "$dest/uv" ] && [ -x "$dest/uvx" ] || die "下载后仍未找到 $dest/uv（或 uvx）"
}

# ===== 子命令 =====

cmd_mirror() {
  require_admin
  local url="${1:-}"
  if [ -z "$url" ]; then
    log "使用 cnpip 选择镜像"
    url="$(pick_fastest_index)" || die "镜像选择失败，请显式指定: muv mirror <url>"
    log "选择镜像: $url"
  fi
  write_index "$url"
}

_do_grant()  { usermod -aG "$UV_GROUP" "$1" && log "$1 已加入 $UV_GROUP（需重新登录生效）"; }
_do_revoke() { gpasswd -d "$1" "$UV_GROUP" && log "$1 已移出 $UV_GROUP（需重新登录生效）"; }

cmd_grant()  { need_root; foreach_user _do_grant  "$@"; }
cmd_revoke() { need_root; foreach_user _do_revoke "$@"; }

cmd_update() {
  require_admin
  local tmp; tmp="$(mktemp -d)"; trap 'rm -rf "$tmp"' RETURN
  bootstrap_uv "$tmp"
  local old new
  old="$("$UV_ROOT/bin/uv" --version 2>/dev/null || echo 'none')"
  install -m 0775 -o root -g "$UV_GROUP" "$tmp/uv"  "$UV_ROOT/bin/uv"
  install -m 0775 -o root -g "$UV_GROUP" "$tmp/uvx" "$UV_ROOT/bin/uvx"
  new="$("$UV_ROOT/bin/uv" --version 2>/dev/null || echo '?')"
  log "uv 已更新: $old -> $new"
}

cmd_python() {
  local action="${1:-}"; shift || true
  local ver=""
  while [ $# -gt 0 ]; do
    case "$1" in
      -*)       die "未知参数: $1" ;;
      *)
        [ -z "$ver" ] || die "只能指定一个 Python 版本"
        ver="$1"; shift
        ;;
    esac
  done
  case "$action" in
    add)
      require_admin
      [ -n "$ver" ] || die "用法: muv python add <ver>"
      log "安装共享 Python $ver 到 $UV_ROOT/python"
      run_uv python install "$ver"
      log "Python $ver 已安装到共享目录；已加载 env.sh 的用户可使用该版本"
      ;;
    rm|remove|uninstall)
      require_admin
      [ -n "$ver" ] || die "用法: muv python rm <ver>"
      local pbin
      pbin="$(run_uv python find "$ver" 2>/dev/null || true)"
      [ -n "$pbin" ] || die "未找到已安装的共享 Python $ver"
      warn "删除后，基于 Python $ver 的 venv 可能因解释器路径缺失而无法运行；重新执行 muv python add $ver 可恢复同一路径"
      printf '确认删除 Python %s？[y/N] ' "$ver" >&2
      read -r ans 2>/dev/null || ans=""
      case "$ans" in y|Y|yes|YES) ;; *) die "已取消" ;; esac
      run_uv python uninstall "$ver"
      log "已删除共享 Python $ver"
      ;;
    list|"")
      run_uv python list --only-installed
      ;;
    *) die "用法: muv python {add|rm|list} [ver]" ;;
  esac
}

cmd_doctor() {
  log "检查 $UV_ROOT"
  local ok=1 index_url
  getent group "$UV_GROUP" >/dev/null && echo "  组 $UV_GROUP: OK" \
    || { echo "  组 $UV_GROUP: 缺失"; ok=0; }
  [ -x "$UV_ROOT/bin/uv" ] && echo "  uv: OK $("$UV_ROOT/bin/uv" --version 2>/dev/null)" \
    || { echo "  uv: 缺失"; ok=0; }
  if command -v getfacl >/dev/null 2>&1; then
    getfacl -p "$UV_ROOT/cache" 2>/dev/null | grep -q '^default:other::rwx' \
      && echo "  cache default ACL(other=rwx): OK" \
      || { echo "  cache default ACL(other=rwx): 缺失"; ok=0; }
  else warn "未找到 getfacl，未检查 ACL"; fi
  index_url="$(read_config_var MUV_DEFAULT_INDEX 2>/dev/null || true)"
  [ -n "$index_url" ] && echo "  镜像源: $index_url" || echo "  镜像源: 未配置"
  [ "$ok" -eq 1 ] && log "检查通过" || { warn "存在问题，见上"; return 1; }
}

cmd_help() { awk 'NR>1 && /^[^#]/{exit} NR>1{sub(/^# ?/,""); print}' "$0"; }

# ===== 分发 =====

ORIG_ARGS=("$@")
cmd="${1:-help}"; shift || true
case "$cmd" in
  mirror)            ensure_runtime_context; cmd_mirror "$@" ;;
  grant)             ensure_runtime_context; cmd_grant "$@" ;;
  revoke)            ensure_runtime_context; cmd_revoke "$@" ;;
  update)            ensure_runtime_context; cmd_update "$@" ;;
  python)            ensure_runtime_context; cmd_python "$@" ;;
  doctor)            ensure_runtime_context; cmd_doctor "$@" ;;
  help|-h|--help)    cmd_help ;;
  install)           die "安装请使用源码目录中的 install.sh" ;;
  *)                 die "未知命令: $cmd（muv help 查看用法）" ;;
esac
